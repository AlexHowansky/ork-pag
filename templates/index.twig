<!doctype html>
<html lang="en">
    <head>
        <title>Pick a Game</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="PAG -- the board game organizer.">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700&display=swap">
        <link rel="stylesheet" href="/pag.min.css">
    </head>
    <body>
{% set playTimes = {15: '15 min', 30: '30 min', 45: '45 min', 60: '1 h', 90: '1 h 30 min', 120: '2 h', 180: '3 h'} %}
{% set summary = [] %}
{% if post.numPlayers is not empty %}
{% set summary = summary|merge([post.numPlayersType == 'suggested' ? 'best with ' ~ post.numPlayers : post.numPlayers ~ ' player' ~ (post.numPlayers > 1 ? 's')]) %}
{% endif %}
{% if post.maxPlayTime is not empty %}
{% set summary = summary|merge([(playTimes[post.maxPlayTime] ?? (post.maxPlayTime ~ ' min')) ~ ' or less']) %}
{% endif %}
{% if post.maxWeight is not empty %}
{% set summary = summary|merge(['weight ' ~ post.maxWeight|number_format(1) ~ ' or less']) %}
{% endif %}
{% if post.cooperative is defined and post.cooperative != '' %}
{% set summary = summary|merge([post.cooperative == 1 ? 'cooperative' : 'competitive']) %}
{% endif %}
{% if post.expansions is not empty %}
{% set summary = summary|merge(['with expansions']) %}
{% endif %}
{% if post.search is not empty %}
{% set summary = summary|merge(['matching “' ~ post.search ~ '”']) %}
{% endif %}
        <main class="column">
            <div class="head">
                <div class="title-row">
                    <div>
                        <h1>
                            <svg class="mark" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                                <rect x="2.75" y="2.75" width="18.5" height="18.5" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
                                <circle cx="7.5" cy="7.5" r="1.75" fill="currentColor"/>
                                <circle cx="12" cy="12" r="1.75" fill="#1d5fbf"/>
                                <circle cx="16.5" cy="16.5" r="1.75" fill="currentColor"/>
                            </svg>
                            Pick a Game
                        </h1>
                        <p class="sub">
                            <span class="num">{{ games|length }}</span> game{{ games|length != 1 ? 's' }}
                            {{- summary is empty ? ' on the shelf' : ' fit: ' ~ summary|join(' · ') }}
                        </p>
                    </div>
                    <label class="scope">
                        <span>Shelf</span>
                        <select name="username" form="form" class="control">
                            <option value="">Everyone’s</option>
    {% for user in users %}
                            <option value="{{ user }}"{{ post.username == user ? ' selected' }}>{{ user }}</option>
    {% endfor %}
                        </select>
                    </label>
                </div>
                <form class="filters" method="post" id="form" role="search">
                    <input name="search" class="control search" type="search" placeholder="Search by name" aria-label="Search by name" autocomplete="off" value="{{ post.search }}">
                    <div class="selects">
                        <select name="numPlayersType" class="control" aria-label="Player count match">
                            <option value="atLeast"{{ post.numPlayersType == 'atLeast' ? ' selected' }}>At least</option>
                            <option value="suggested"{{ post.numPlayersType == 'suggested' ? ' selected' }}>Best with</option>
                        </select>
                        <select name="numPlayers" class="control" aria-label="Number of players">
                            <option value="">Any players</option>
    {% for players in range(1, 10) %}
                            <option value="{{ players }}"{{ post.numPlayers == players ? ' selected' }}>{{ players }} player{{ players > 1 ? 's' }}</option>
    {% endfor %}
                        </select>
                        <select name="maxPlayTime" class="control" aria-label="Longest play time">
                            <option value="">Any length</option>
    {% for playtime, label in playTimes %}
                            <option value="{{ playtime }}"{{ post.maxPlayTime == playtime ? ' selected' }}>{{ label }} or less</option>
    {% endfor %}
                        </select>
                        <select name="maxWeight" class="control" aria-label="Heaviest weight">
                            <option value="">Any weight</option>
    {% for weight in [1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5] %}
                            <option value="{{ weight }}"{{ post.maxWeight == weight ? ' selected' }}>Weight {{ weight|number_format(1) }} or less</option>
    {% endfor %}
                        </select>
                        <select name="cooperative" class="control" aria-label="Cooperative or competitive">
                            <option value="">Any type</option>
                            <option value="0"{{ post.cooperative is defined and post.cooperative == 0 ? ' selected' }}>Competitive</option>
                            <option value="1"{{ post.cooperative is defined and post.cooperative == 1 ? ' selected' }}>Cooperative</option>
                        </select>
                        <select name="expansions" class="control" aria-label="Expansions">
                            <option value="0"{{ post.expansions is empty ? ' selected' }}>No expansions</option>
                            <option value="1"{{ post.expansions is not empty ? ' selected' }}>With expansions</option>
                        </select>
                        <button type="button" class="btn" id="clear">Clear</button>
                    </div>
                </form>
            </div>
            <div class="panel">
                <table id="table">
                    <thead>
                        <tr>
                            <th>Game</th>
                            <th class="num rank">Rank</th>
                            <th class="num">Rating</th>
                            <th class="players">Players</th>
                            <th class="num">Play time</th>
                            <th class="num">Weight</th>
                            <th class="num wide">Year</th>
                        </tr>
                    </thead>
                    <tbody>
{% if games is empty %}
                        <tr class="empty">
                            <td colspan="7">Nothing on the shelf fits. Loosen a filter or clear them all.</td>
                        </tr>
{% else %}
{% for game in games %}
{% set players = game.minPlayers == game.maxPlayers ? game.minPlayers : game.minPlayers ~ '–' ~ game.maxPlayers %}
{% set best = game.recommendedPlayers and game.minPlayers != game.maxPlayers ? game.recommendedPlayers : null %}
{% set time = game.minPlayTime == game.maxPlayTime ? game.minPlayTime : game.minPlayTime ~ '–' ~ game.maxPlayTime %}
                        <tr data-game-id="{{ game.id }}">
                            <td data-order="{{ game.name }}">
                                <div class="game">
                                    <img src="{{ game.thumbnail }}" alt="" loading="lazy" width="96">
                                    <div>
                                        <a href="{{ game.url }}" target="_blank" rel="noopener">{{ game.name }}</a>
                                        <span class="meta">{{ game.cooperative ? 'Cooperative' : 'Competitive' }}</span>
                                        <span class="meta compact">{{ players }} player{{ game.maxPlayers > 1 ? 's' }}{{ best ? ', best ' ~ best }} · {{ time ?: '—' }}{{ time ? ' min' }} · weight {{ game.weight|number_format(1) }} · rated {{ game.geekRating|number_format(1) }}</span>
                                    </div>
                                </div>
                            </td>
                            <td class="num rank" data-order="{{ game.rank ?: 999999 }}"><span class="rank-label">Rank</span>{% if game.rank %}{{ game.rank }}{% else %}<span class="dash" title="Not ranked">—</span>{% endif %}</td>
                            <td class="num">{{ game.geekRating|number_format(1) }}</td>
                            <td class="players" data-order="{{ game.minPlayers * 100 + game.maxPlayers }}">
                                <span class="strip" aria-hidden="true">
{%- for n in 1..8 -%}
<i class="{{ n == best ? 'best' : (n >= game.minPlayers and (n <= game.maxPlayers) ? 'on') }}"></i>
{%- endfor -%}
                                </span>
                                <span class="num">{{ players }}</span>{% if best %} <span class="unit">best {{ best }}</span>{% endif %}
                            </td>
                            <td class="num" data-order="{{ game.playTime }}">{% if time %}{{ time }}<span class="unit"> min</span>{% else %}<span class="dash">—</span>{% endif %}</td>
                            <td class="num" data-order="{{ game.weight }}">{% if game.weight %}<span class="weight">{{ game.weight|number_format(1) }}<span class="meter" aria-hidden="true"><i style="width: {{ ((game.weight - 1) / 4 * 100)|round(1) }}%"></i></span></span>{% else %}<span class="dash" title="Not rated">—</span>{% endif %}</td>
                            <td class="num wide">{{ game.yearPublished ?: '—' }}</td>
                        </tr>
{% endfor %}
{% endif %}
                    </tbody>
                </table>
            </div>
        </main>
        <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js" integrity="sha512-1g+lD9RHY4sYTrehMnFuWSqn3GS1xE2nhSSb5a8JS0WYMnvm1iuxpajRACu0C9tmJSL78O7eQw9TUhGUsRFc0g==" crossorigin="anonymous"></script>
        <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js" integrity="sha512-6kX4REOO8EAxC+ZL7s1qD6ltNliHAYc4zbQXq7aeDQNaPWhcMxHK6jWULhDFf/ryjyZROe+0tQA9aturPI5V/Q==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script src="/pag.min.js"></script>
    </body>
</html>
